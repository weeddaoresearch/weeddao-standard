      "scope": {
        "program": "Adult-use and medical cannabis laboratory testing",
        "product_types": [
          "adult-use cannabis products",
          "medical cannabis products"
        ],
        "matrices": [],
        "notes": "Narrow laboratory-qualification and quality-system seed from the current OCM Part 130 audit checklist."
      },
      "requirements": [
        {
          "requirement_id": "iso-17025-accreditation",
          "requirement_type": "other",
          "analyte_id": null,
          "test_category": "laboratory_qualification",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Cannabis laboratories must maintain ISO/IEC 17025 accreditation or an Office-approved accreditation based on ISO/IEC 17025.",
          "notes": "Modeled as a laboratory qualification rule, not an analyte threshold."
        },
        {
          "requirement_id": "proficiency-testing-six-months",
          "requirement_type": "other",
          "analyte_id": null,
          "test_category": "proficiency_testing",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Cannabis laboratories must participate in ISO/IEC 17043-approved proficiency tests every six months (+/- 30 days) and meet the Part 130 pass-history requirement.",
          "notes": "Frequency and pass-history requirement are preserved in the source summary."
        }
      ],
      "sources": [
        {
          "title": "NYS OCM Part 130 Checklist, Version 5",
          "url": "https://cannabis.ny.gov/part-130-checklist",
          "citation": "§130.7(a), §130.10(a), §130.7(b); effective 2026-01-30",
          "retrieved_at": "2026-09-19T00:00:00Z",
          "source_hash": null
        }
      ],
      "supersedes": []
    },
