    {
      "registry_version": "0.1-draft",
      "rule_id": "WDA-RULE-US-NY-OCM-POTENCY-2026",
      "jurisdiction": {
        "country": "US",
        "subdivision": "US-NY",
        "name": "New York"
      },
      "authority": "New York State Office of Cannabis Management",
      "status": "active",
      "effective": {
        "published_date": "2026-02-09",
        "start_date": "2026-02-09",
        "end_date": null
      },
      "scope": {
        "program": "Adult-use and medical cannabis testing",
        "product_types": [
          "final cannabis products"
        ],
        "matrices": [],
        "notes": "Potency reporting and homogeneity requirements from Tables/sections in the February 9, 2026 testing-limits document."
      },
      "requirements": [
        {
          "requirement_id": "total-thc-always-reported",
          "requirement_type": "reporting_requirement",
          "analyte_id": "WDA-AN-000011",
          "test_category": "phytocannabinoid_profile",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Total THC must always be reported.",
          "notes": "Individual delta-9, delta-8 and delta-10 results may also be reported."
        },
        {
          "requirement_id": "medical-labeled-potency-variance",
          "requirement_type": "other",
          "analyte_id": "WDA-AN-000011",
          "test_category": "potency",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Medical cannabis labeled potency acceptance is 90-110%, subject to the stated low-dose laboratory-variability provision.",
          "notes": "Stored as a non-scalar rule because the acceptance range has lower and upper bounds."
        },
        {
          "requirement_id": "adult-use-labeled-potency-variance",
          "requirement_type": "other",
          "analyte_id": "WDA-AN-000011",
          "test_category": "potency",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Adult-use labeled potency acceptance is 85-115%.",
          "notes": "Stored as a non-scalar rule because the acceptance range has lower and upper bounds."
        },
        {
          "requirement_id": "homogeneity-five-samples",
          "requirement_type": "sampling_rule",
          "analyte_id": null,
          "test_category": "homogeneity",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Five samples across a cannabis product batch or lot must be tested for potency for applicable final concentrates and edible products.",
          "notes": null
        },
        {
          "requirement_id": "homogeneity-25-percent-of-mean",
          "requirement_type": "other",
          "analyte_id": "WDA-AN-000011",
          "test_category": "homogeneity",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "For applicable products, each submitted sample's total THC and CBD concentration per single dose generally must be within 25% of the mean for the lot; a separate 0.5 mg rule applies to specified concentrations below 2 mg per dose.",
          "notes": "Rule also applies to total CBD; only Total THC is linked here because the current seed has a stable Total THC ID and the range is not representable as one scalar threshold."
        }
      ],
      "sources": [
        {
          "title": "NYS OCM Cannabis Testing Limits",
          "url": "https://cannabis.ny.gov/laboratory-testing-limits",
          "citation": "Revision February 9, 2026, phytocannabinoid profile and homogeneity sections",
          "retrieved_at": "2026-09-19T00:00:00Z",
          "source_hash": null
        }
      ],
