      "scope": {
        "program": "Adult-use and medical cannabis testing",
        "product_types": [
          "all final cannabis products including beverages"
        ],
        "matrices": [],
        "notes": "Table 8 pesticide limits, Cannabis Testing Limits revision February 9, 2026."
      },
      "requirements": [
        {
          "requirement_id": "abamectin-action-limit",
          "requirement_type": "action_limit",
          "analyte_id": "WDA-AN-000016",
          "test_category": "pesticides",
          "comparator": "<=",
          "threshold": {
            "value": 0.5,
            "unit": "ppm",
            "unit_system": "source_native",
            "reported_as": "0.500 ppm = 1 µg/g"
          },
          "source_text_summary": "New York Table 8 action limit for Abamectin.",
          "notes": "OCM lists CAS 71751-41-2 for the analyte labeled Abamectin."
        },
        {
          "requirement_id": "acephate-action-limit",
          "requirement_type": "action_limit",
          "analyte_id": "WDA-AN-000017",
          "test_category": "pesticides",
          "comparator": "<=",
          "threshold": {
            "value": 0.4,
            "unit": "ppm",
            "unit_system": "source_native",
            "reported_as": "0.400 ppm = 1 µg/g"
          },
          "source_text_summary": "New York Table 8 action limit for Acephate.",
          "notes": "OCM lists CAS 30560-19-1."
        },
        {
          "requirement_id": "declared-pesticides-targeted-testing",
          "requirement_type": "required_test",
          "analyte_id": null,
          "test_category": "pesticides",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Any pesticide, including growth regulators and myclobutanil, used during production must be declared for targeted testing in addition to the listed pesticide contaminants.",
          "notes": null
        },
        {
          "requirement_id": "tic-reporting",
          "requirement_type": "reporting_requirement",
          "analyte_id": null,
          "test_category": "pesticides",
          "comparator": null,
          "threshold": null,
          "source_text_summary": "Where individual/mixed standards do not support quantitative confirmation, applicable pesticide results should be reported as TIC and the term defined in the report footnote.",
          "notes": "Demonstrates a regulator-defined result-state/reporting semantic."
        }
      ],
