          "test_category": "tetrahydrocannabinols",
          "comparator": "<=",
          "threshold": {
            "value": 10,
            "unit": "mg/dosage_unit",
            "unit_system": "source_native",
            "reported_as": "not more than 10 milligrams of tetrahydrocannabinols in each dosage unit"
          },
          "source_text_summary": "Texas statutory definition uses a dosage-unit THC maximum.",
          "notes": "This seed preserves the statute's aggregate tetrahydrocannabinols wording and does not map it to a specific THC isomer."
        }
