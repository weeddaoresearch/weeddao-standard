{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weeddao.org/schemas/weeddao-sampling-assurance-0.1-draft.schema.json",
  "title": "WeedDAO Sampling Assurance Sidecar 0.1 Draft",
  "description": "Experimental sidecar for sampling representativeness, composite-sample formation, and test-specimen reduction. This does not modify WeedDAO v0.2-draft.",
  "type": "object",
  "required": ["sampling_assurance_version", "status", "record_ref", "sampling_events"],
  "additionalProperties": false,
  "properties": {
    "sampling_assurance_version": { "const": "0.1-draft" },
    "status": { "const": "experimental" },
    "record_ref": { "$ref": "#/$defs/RecordRef" },
    "sampling_events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SamplingEvent" }
    },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "RecordRef": {
      "type": "object",
      "required": ["schema_version"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "record_id": { "type": ["string", "null"] },
        "subject_id": { "type": ["string", "null"] },
        "sample_id": { "type": ["string", "null"] },
        "source_id": { "type": ["string", "null"] }
      }
    },
    "Quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "Population": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_type": {
          "type": ["string", "null"],
          "enum": ["field_lot", "harvest_batch", "product_batch", "container_lot", "other", null]
        },
        "population_id": { "type": ["string", "null"] },
        "declared_size": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "description": { "type": ["string", "null"] }
      }
    },
    "SamplingPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_id": { "type": ["string", "null"] },
        "plan_type": {
          "type": ["string", "null"],
          "enum": [
            "regulatory_standard",
            "performance_based",
            "consensus_standard",
            "customer_specified",
            "laboratory_internal",
            "research",
            "other",
            "unknown",
            null
          ]
        },
        "procedure_reference": { "type": ["string", "null"] },
        "selection_method": {
          "type": ["string", "null"],
          "enum": [
            "random",
            "systematic",
            "stratified",
            "judgmental",
            "composite_protocol",
            "source_reported",
            "other",
            "unknown",
            null
          ]
        },
        "target_confidence_level_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "target_exceedance_fraction_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Optional source-defined population criterion; do not infer."
        },
        "source_reference": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "Increment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "increment_id": { "type": ["string", "null"] },
        "location_label": { "type": ["string", "null"] },
        "material_description": { "type": ["string", "null"] },
        "mass": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "collected_at": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "CompositeSample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_composite": { "type": ["boolean", "null"] },
        "increment_count": { "type": ["integer", "null"], "minimum": 1 },
        "combined_mass": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "formation_method": { "type": ["string", "null"] },
        "increments": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/Increment" }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "TestSpecimenPreparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whole_received_sample_processed": { "type": ["boolean", "null"] },
        "drying_method": { "type": ["string", "null"] },
        "drying_endpoint": { "type": ["string", "null"] },
        "grinding_method": { "type": ["string", "null"] },
        "homogenization_method": { "type": ["string", "null"] },
        "particle_size_min": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "particle_size_max": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "test_specimen_mass": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "retain_specimen_created": { "type": ["boolean", "null"] },
        "retain_specimen_mass": {
          "anyOf": [
            { "$ref": "#/$defs/Quantity" },
            { "type": "null" }
          ]
        },
        "subsampling_method": { "type": ["string", "null"] },
        "source_reference": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "Representativeness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_claim": { "type": ["string", "null"] },
        "claim_type": {
          "type": ["string", "null"],
          "enum": ["representative", "compliance_sample", "research_sample", "grab_sample", "unknown", "other", null]
        },
        "statistical_basis_reported": { "type": ["boolean", "null"] },
        "limitations": { "type": ["string", "null"] },
        "source_reference": { "type": ["string", "null"] }
      }
    },
    "SamplingEvent": {
      "type": "object",
      "required": ["event_id"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "population": {
          "anyOf": [
            { "$ref": "#/$defs/Population" },
            { "type": "null" }
          ]
        },
        "plan": {
          "anyOf": [
            { "$ref": "#/$defs/SamplingPlan" },
            { "type": "null" }
          ]
        },
        "collection_party": {
          "type": ["string", "null"],
          "enum": ["client", "laboratory", "regulator", "third_party", "researcher", "unknown", null]
        },
        "collector_role": { "type": ["string", "null"] },
        "collected_at": { "type": ["string", "null"] },
        "sample_id": { "type": ["string", "null"] },
        "composite_sample": {
          "anyOf": [
            { "$ref": "#/$defs/CompositeSample" },
            { "type": "null" }
          ]
        },
        "test_specimen_preparation": {
          "anyOf": [
            { "$ref": "#/$defs/TestSpecimenPreparation" },
            { "type": "null" }
          ]
        },
        "representativeness": {
          "anyOf": [
            { "$ref": "#/$defs/Representativeness" },
            { "type": "null" }
          ]
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
